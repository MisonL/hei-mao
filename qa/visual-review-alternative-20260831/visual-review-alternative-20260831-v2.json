        "normal",
        "grayscale",
        "protanopia approximation",
        "deuteranopia approximation",
        "tritanopia approximation"
      ],
      "display_size": "48x52 equivalent",
      "purpose": "check pose/silhouette readability when color cues are reduced"
    },
    {
      "name": "compositing/occlusion rehearsal",
      "purpose": "render representative cells against adversarial backgrounds and bubble-like high-contrast fields to expose hidden RGB, edge bleed, or visually merged silhouettes",
      "note": "asset-only rehearsal; not a claim about live Codex App z-order",
      "result": "Adversarial checker/stripe/gradient composite sheet plus a bubble-and-neighbor layering rehearsal; no alpha bbox instability or detached-pixel candidate was promoted. Live Codex App z-order and cross-screen tracking remain separate."
    },
    {
      "name": "temporal anchor and scale trajectory",
      "purpose": "plot lower-body anchor, bbox height, adjacent duplicate candidates, and abrupt registration/scale candidates over every non-empty frame"
    }
